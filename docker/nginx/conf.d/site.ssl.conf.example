# После init-ssl.sh копируется в site.conf (DOMAIN подставляется скриптом).
# gzip уже включён в nginx.conf — здесь не дублировать.

upstream api {
    server api:3000;
}

# Art-studio Directus — frozen (profile art-studio). Uncomment when unfreezing:
# upstream directus {
#     server directus:8055;
# }

server {
    listen 443 ssl;
    http2 on;
    server_name DOMAIN www.DOMAIN;

    ssl_certificate /etc/letsencrypt/live/DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    index index.html;

    location /api/contact {
        limit_req zone=contact_limit burst=3 nodelay;
        proxy_pass http://api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Art-studio preview + CMS — frozen to free VPS RAM (~400MB Directus).
    # Data volumes are kept; see docs/DIRECTUS-DEMO.md to unfreeze.
    location ^~ /p/art-studio/ {
        default_type text/plain;
        return 503 'Art studio preview is temporarily frozen.\n';
    }

    location ^~ /artStudio/ {
        default_type text/plain;
        return 503 'Art studio demo is temporarily frozen.\n';
    }

    location = /cms {
        return 302 /cms/;
    }

    location ^~ /cms/ {
        default_type text/plain;
        return 503 'Art studio CMS is temporarily frozen.\n';
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    server_name DOMAIN www.DOMAIN;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
