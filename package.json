{
    "name": "danilmakes",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "npm": ">=10.0.0",
        "node": ">=18.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "build:tariff-prices": "cd demos/tariff-prices && npm ci && VITE_DEMO_API=${VITE_DEMO_API:-live} npm run build && rm -rf ../../public/tariffPrices && cp -r dist ../../public/tariffPrices",
        "build:report-revenue": "cd demos/report-revenue && npm ci && VITE_DEMO_API=${VITE_DEMO_API:-live} npm run build && rm -rf ../../public/reportRevenue && cp -r dist ../../public/reportRevenue",
        "build:xlsx-pipeline": "rm -rf public/xlsxPipeline && mkdir -p public/xlsxPipeline && cp -r demos/xlsx-pipeline/. public/xlsxPipeline/",
        "build:once-migration": "rm -rf public/onceMigration && mkdir -p public/onceMigration && cp -r demos/once-migration/. public/onceMigration/",
        "build:divisions": "cd demos/divisions && npm ci && npm run build && cp public/mockServiceWorker.js dist/mockServiceWorker.js && rm -rf ../../public/divisions && cp -r dist ../../public/divisions",
        "build:family-meals": "cd ../family_meal-planning/frontend && npm ci && npm run build:demo && rm -rf ../../danilmakes/public/familyMeals && cp -r dist-demo/familyMeals ../../danilmakes/public/familyMeals",
        "build:all-demos": "bash scripts/build-all-demos.sh",
        "sync:art-studio": "bash scripts/sync-art-studio.sh",
        "directus:setup-art-studio": "node scripts/directus-art-studio-setup.mjs",
        "directus:media-art-studio": "node scripts/directus-art-studio-media.mjs",
        "directus:extend-art-studio": "node scripts/directus-art-studio-content-extend.mjs",
    "directus:split-hero": "node scripts/directus-art-studio-split-hero.mjs",
    "directus:cleanup-settings": "node scripts/directus-art-studio-cleanup-settings.mjs",
    "directus:split-sections": "node scripts/directus-art-studio-split-sections.mjs",
    "directus:split-contacts": "node scripts/directus-art-studio-split-contacts.mjs",
    "directus:merge-sections": "node scripts/directus-art-studio-merge-sections.mjs",
    "directus:flatten-sections": "node scripts/directus-art-studio-flatten-sections.mjs",
    "directus:cms-cleanup": "node scripts/directus-art-studio-cms-cleanup.mjs",
    "directus:merge-schedule": "node scripts/directus-art-studio-merge-schedule.mjs",
    "directus:merge-studio": "node scripts/directus-art-studio-merge-studio.mjs",
    "directus:fix-group-photos": "node scripts/directus-art-studio-fix-group-photos.mjs",
        "compress:layout-images": "node scripts/compress-layout-images.mjs",
        "metrika:fetch": "node scripts/fetch-metrika.mjs"
    },
    "dependencies": {
        "@reduxjs/toolkit": "^1.9.5",
        "axios": "^1.4.0",
        "bootstrap": "^5.2.3",
        "react": "^18.2.0",
        "react-bootstrap": "^2.7.4",
        "react-dom": "^18.2.0",
        "react-redux": "^8.0.5",
        "react-router": "^6.11.2",
        "react-router-dom": "^6.11.2",
        "redux-saga": "^1.2.3"
    },
    "devDependencies": {
        "@types/react": "^18.0.28",
        "@types/react-dom": "^18.0.11",
        "@types/react-router": "^5.1.20",
        "@types/react-router-dom": "^5.3.3",
        "@typescript-eslint/eslint-plugin": "^5.57.1",
        "@typescript-eslint/parser": "^5.57.1",
        "@vitejs/plugin-react-swc": "^3.0.0",
        "eslint": "^8.38.0",
        "eslint-plugin-react": "^7.32.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.3.4",
        "sass": "^1.62.1",
        "sharp": "^0.33.5",
        "typescript": "^5.0.2",
        "vite": "^4.3.2",
        "vite-plugin-svgr": "^3.2.0",
        "vite-tsconfig-paths": "^4.2.0"
    }
}
