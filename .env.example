# PostgreSQL
POSTGRES_USER=danilmakes
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=danilmakes

# API
DATABASE_URL=postgresql://danilmakes:change_me_strong_password@postgres:5432/danilmakes
PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://danilmakes.ru

# Site shell mode: hiring (default) | freelance — flip after offer without deleting code
# VITE_SITE_MODE is baked at frontend build time
VITE_SITE_MODE=hiring

# Demo apps: live (default in prod builds) | msw — MSW fixtures without API
# VITE_DEMO_API=live
VITE_DEMO_API=live

# Path to tariff fixture JSON (Docker sets /app/fixtures/tariffs)
# DEMO_TARIFF_FIXTURES=

# Yandex SMTP (https://id.yandex.ru → Пароли приложений)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your@yandex.ru
SMTP_PASS=your_app_password
NOTIFY_EMAIL=ya@daniluhov.ru

# Яндекс.Метрика API (локально: npm run metrika:fetch) — не коммитить токен
# OAuth: https://oauth.yandex.ru → приложение с доступом metrika:read
YANDEX_METRIKA_TOKEN=
YANDEX_METRIKA_COUNTER_ID=110107124

# Демо-формы (localLanding, clinicLanding, formIntegration) — опционально
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Закрытый пример изостудии (только пароль, без логина)
# Сейчас frozen на VPS (Directus profile art-studio off) — см. docs/DIRECTUS-DEMO.md
# Ссылка для заказчика: https://danilmakes.ru/p/art-studio/
ART_STUDIO_PREVIEW_PASSWORD=change_me_preview_password
ART_STUDIO_PREVIEW_SECRET=change_me_cookie_signing_secret

# Directus CMS demo — frozen by default (docker compose profile: art-studio)
# Generate: openssl rand -hex 32
DIRECTUS_SECRET=change_me_directus_secret
DIRECTUS_KEY=change_me_directus_key
DIRECTUS_ADMIN_EMAIL=admin@danilmakes.ru
DIRECTUS_ADMIN_PASSWORD=change_me_directus_admin_password
DIRECTUS_PUBLIC_URL=https://danilmakes.ru/cms

# SSL / domain (for init-ssl.sh)
DOMAIN=danilmakes.ru
CERTBOT_EMAIL=ya@daniluhov.ru
